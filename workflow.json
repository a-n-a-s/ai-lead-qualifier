      "parameters": {
        "jsCode": "const text =$('Conversation Agent').first().json.output\n\nconst message = text.split(\"LEAD_DATA_START\")[0].trim();\n\nreturn [\n  {\n    json: {\n      message:\"Thank you , We'll be reaching out to you soon.\"\n    }\n  }\n];\n"
      },
