    {
      "parameters": {
        "jsCode": "const text = $input.first().json.output;\n\n// Extract JSON between the markers\nconst match = text.match(/LEAD_DATA_START\\s*([\\s\\S]*?)\\s*LEAD_DATA_END/);\n\nif (!match) {\n  throw new Error(\"Lead data not found\");\n}\n\nconst leadData = JSON.parse(match[1]);\n\nreturn [\n  {\n    json: leadData\n  }\n];"
      },
